# 3과목 .env 예시 — 노트북은 이 폴더의 .env를 읽는다
# 값을 채우기 전에 먼저 복사한다: copy .env.example .env
# .env는 커밋하지 않는다. 이 파일(.env.example)에는 실제 값을 넣지 않는다.
# 2과목 폴더의 .env와는 따로다 — 2과목에서 발급한 키를 여기에 다시 넣는다.

# 모든 노트북 (필수)
OPENAI_API_KEY=
# M1 Day 5 확장 「웹 조사 리서치 팀」 — 뉴스 검색 (2과목 「외부 API 키 발급」 문서의 Tavily 키)
TAVILY_API_KEY=

# M2 Day 9 확장 「LangSmith로 에이전트 단계 추적」 — 이 노트북만 추적을 켠다
LANGSMITH_API_KEY=

# 추적 끄기 — 2과목 Day 17에서 켰다면 여기서 끈다 (Day 9 확장은 노트북 안에서 켠다)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# M3 Day 16 「보안 운영 체계」 키트 — M2 Day 11 lab과 같은 PostgreSQL 주소
# 형식은 M2 Day 11 lab 폴더의 .env.example을 참고한다
DATABASE_URL=
